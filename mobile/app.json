{
  "expo": {
    "name": "Quick Sales Hub",
    "slug": "quick-sales-hub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "quicksalehub",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.quicksalehub.app",
      "versionCode": 1,
      "permissions": ["INTERNET"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2f3cff"
      }
    },
    "extra": {
      "apiBaseUrl": "https://www.quicksalehub.com"
    }
  }
}
